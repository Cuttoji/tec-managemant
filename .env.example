# ── Docker Compose environment variables ──────────────────────────────────────
# Copy this file to .env and fill in real values before running docker compose up

# JWT secret for express-app (generate: openssl rand -hex 32)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# NextAuth / Auth.js secret (generate: openssl rand -base64 32)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Public URL of the frontend (change to your server IP/domain in production)
NEXTAUTH_URL=http://localhost:3002
