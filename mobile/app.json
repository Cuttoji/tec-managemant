{
  "expo": {
    "name": "TechManage",
    "slug": "techmanage-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1e3a5f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techmanage.mobile"
    },
    "android": {
      "package": "com.techmanage.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      }
    },
    "web": {
      "favicon": "./assets/icon.svg"
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
